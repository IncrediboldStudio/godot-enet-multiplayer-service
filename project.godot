; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-enet-multiplayer-service"
run/main_scene="res://demo/scn_demo.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ENetMultiplayerService="*res://addons/enet-multiplayer-service/enet_multiplayer_service.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/enet-multiplayer-service/plugin.cfg")

[enet_multiplayer_service]

use_dedicated_server=false
